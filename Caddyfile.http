# HTTP-only Caddyfile. Active when HTTP_ONLY=true in .env (the caddy
# container's entrypoint picks this file over the default Caddyfile).
#
# Two intended deployment shapes:
#
#   1. Behind a load balancer / reverse proxy that terminates TLS. Caddy
#      sees plain HTTP from the LB; the browser sees HTTPS at the LB. Keep
#      COOKIES_SECURE=true; uvicorn honors X-Forwarded-Proto so cookies and
#      launch-redirect URLs come out HTTPS at the browser.
#
#   2. Local testing or strictly-internal deployments where TLS isn't
#      desired. Set COOKIES_SECURE=false so the browser sends cookies over
#      HTTP, and the launch redirect uses ``http://`` scheme.
#
# What's intentionally different from the default Caddyfile:
#   - The ``http://`` site-address prefix disables Caddy's automatic-HTTPS
#     feature. No Let's Encrypt requests, no port 443 binding.
#   - No ``on_demand_tls`` global block / ``tls { on_demand }`` site
#     directive — there's no TLS to negotiate.
#   - No ``Strict-Transport-Security`` header. HSTS over plain HTTP is
#     invalid; behind an LB the LB itself should set HSTS.
#   - ``frame-ancestors`` on the child-app CSP accepts both ``http://`` and
#     ``https://`` flavors of SITE_URL so the iframe wrapper works whether
#     the browser sees the portal at HTTP (local-testing) or HTTPS
#     (behind-LB) — only one matches the real document URL at runtime.

http://{$SITE_URL:localhost} {
	reverse_proxy portal:8000

	encode zstd gzip

	# Portal-shell headers — scoped to NON-/apps/* paths only. See the
	# default Caddyfile for the matcher-ordering rationale; without this
	# matcher, the matcher-less header block runs AFTER the @apps block
	# and clobbers the apps CSP / re-adds XFO DENY on the iframe target.
	@portal_shell not path /apps/*
	header @portal_shell {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Portal-shell CSP. Same as the default Caddyfile minus HSTS.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# /apps/* paths: the portal's ChildAppCSPMiddleware stamps the CSP
	# header (it derives per-app ``connect-src`` from
	# ``App.allowed_origins``, which Caddy can't see). The other defense-
	# in-depth headers stay here. No XFO at all because Safari treats XFO
	# DENY as authoritative even when CSP frame-ancestors would allow
	# framing, producing a "refused to connect" iframe error.
	@apps path /apps/*
	header @apps {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# Per-app subdomains. Same routing as the default Caddyfile, just served
# over plain HTTP. The portal's HostDispatchMiddleware still resolves
# ``<slug>.apps.<SITE_URL>`` to a per-app origin, and AppSession cookies
# stay scoped to the subdomain.
http://*.apps.{$SITE_URL} {
	reverse_proxy portal:8000

	encode zstd gzip

	header {
		# Per-app Content-Security-Policy is set by the portal's
		# ChildAppCSPMiddleware (it derives per-app ``connect-src`` from
		# ``App.allowed_origins`` and accepts both http:// and https://
		# ``frame-ancestors`` schemes under HTTP_ONLY so the iframe
		# wrapper works whether the browser sees the portal at HTTP
		# (local-testing) or HTTPS (behind-LB)). Defense-in-depth
		# headers below stay in Caddy. HSTS deliberately omitted — see
		# header block above for the rationale.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
