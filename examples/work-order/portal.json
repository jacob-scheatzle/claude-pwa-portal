{
  "slug": "work-order",
  "name": "Work Order",
  "version": "1.1.0",
  "description": "Log a field-service job — labor + itemized parts — then generate, share, or email a work-order PDF.",
  "icon": "icon.png",
  "entry": "index.html",
  "services": ["pdf", "email", "storage"],
  "permissions": {
    "network": []
  },
  "tools": [
    {
      "name": "create_work_order",
      "description": "Render a work-order PDF (labor + itemized parts + total) and return a shareable link.",
      "params": [
        {"name": "customer", "type": "string", "required": true},
        {"name": "site_address", "type": "string", "required": false, "description": "Job site address"},
        {"name": "description", "type": "string", "required": true, "description": "Work performed"},
        {"name": "hours", "type": "number", "required": true, "description": "Labor hours"},
        {"name": "rate", "type": "number", "required": true, "description": "Labor rate, USD per hour"},
        {"name": "parts", "type": "array", "required": false, "description": "Parts / materials used",
          "fields": [
            {"name": "name", "type": "string", "required": true},
            {"name": "qty", "type": "number", "required": true},
            {"name": "price", "type": "number", "required": true, "description": "Unit price in USD"}
          ]}
      ],
      "render": {
        "html": "<style>body{font-family:system-ui,-apple-system,sans-serif;color:#1c1917}h1{font-size:20pt;margin:0 0 2pt}.sub{color:#57534e;margin-bottom:12pt}.desc{white-space:pre-wrap;color:#44403c;margin-bottom:12pt}table{width:100%;border-collapse:collapse;margin-top:8pt}th{text-align:left;font-size:9pt;text-transform:uppercase;letter-spacing:.05em;color:#78716c;border-bottom:2px solid #1c1917;padding:4pt 6pt}td{padding:5pt 6pt;border-bottom:1px solid #e7e5e4}.r{text-align:right}.totals{margin-top:10pt;margin-left:auto;width:18rem}.totals td{border:0;padding:2pt 6pt}.grand td{font-weight:700;font-size:13pt;border-top:2px solid #1c1917;padding-top:5pt}</style><h1>Work Order</h1><div class='sub'>For {{ customer }}{% if site_address %} &middot; {{ site_address }}{% endif %}</div><div class='desc'>{{ description }}</div>{% set ns = namespace(parts=0) %}{% if parts %}<table><thead><tr><th>Part</th><th class='r'>Qty</th><th class='r'>Price</th><th class='r'>Amount</th></tr></thead><tbody>{% for p in parts %}<tr><td>{{ p.name }}</td><td class='r'>{{ '%.2f'|format(p.qty) }}</td><td class='r'>${{ '%.2f'|format(p.price) }}</td><td class='r'>${{ '%.2f'|format(p.qty * p.price) }}</td></tr>{% set ns.parts = ns.parts + p.qty * p.price %}{% endfor %}</tbody></table>{% endif %}<table class='totals'><tr><td>Labor ({{ '%.2f'|format(hours) }} hr &times; ${{ '%.2f'|format(rate) }})</td><td class='r'>${{ '%.2f'|format(hours * rate) }}</td></tr><tr><td>Parts</td><td class='r'>${{ '%.2f'|format(ns.parts) }}</td></tr><tr class='grand'><td>Total</td><td class='r'>${{ '%.2f'|format((hours * rate) + ns.parts) }}</td></tr></table>",
        "filename": "work-order.pdf",
        "branded": true
      },
      "deliver": {"kind": "share", "ttl_days": 30}
    },
    {
      "name": "email_work_order",
      "description": "Email a work-order summary to the customer.",
      "params": [
        {"name": "to", "type": "string", "required": true, "description": "Customer email"},
        {"name": "customer", "type": "string", "required": true},
        {"name": "description", "type": "string", "required": true, "description": "Work performed"},
        {"name": "total", "type": "number", "required": true, "description": "Total in USD"}
      ],
      "render": {
        "html": "<div style='font-family:system-ui,-apple-system,sans-serif;color:#1c1917;font-size:14px;line-height:1.6'><p>Hi {{ customer }},</p><p>Here is a summary of the work completed:</p><div style='white-space:pre-wrap;color:#44403c'>{{ description }}</div><p>Total: <strong>${{ '%.2f'|format(total) }}</strong>. Thank you!</p></div>",
        "branded": true
      },
      "deliver": {"kind": "email", "to": "{{ to }}", "subject": "Your work order"}
    }
  ],
  "min_portal_version": "0.1.0"
}
