# Global options. ``on_demand_tls.ask`` tells Caddy to consult the portal
# before issuing a certificate for any host matched by an ``on_demand`` block
# below. Without this guardrail, an attacker could send requests for
# ``<random>.apps.<SITE_URL>`` and burn through Let's Encrypt's per-week
# certificate quota. The portal answers 200 only for real, enabled app slugs
# (and for the portal hostname itself, defensively).
{
	on_demand_tls {
		ask http://portal:8000/api/v1/internal/cert-ask
	}
}

{$SITE_URL:localhost} {
	reverse_proxy portal:8000

	encode zstd gzip

	# Portal-shell headers — scoped to NON-/apps/* paths only. The
	# ``not path /apps/*`` matcher is critical: without it, the matcher-less
	# header block gets compiled to run AFTER the @apps matcher block,
	# clobbering the apps-specific CSP and putting an XFO DENY on the iframe
	# target. Scoping both header blocks with matchers means they never
	# overlap on a given request.
	@portal_shell not path /apps/*
	header @portal_shell {
		# HSTS is only emitted over HTTPS by Caddy automatically.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Portal-shell CSP. Stricter than the child-app CSP below: no
		# 'unsafe-eval', no blob:, no data: in default-src. 'unsafe-inline'
		# is required because base.html ships an inline <script> for
		# service-worker registration and templates use inline <style>.
		# frame-ancestors 'none' blocks any page from iframing the shell.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# /apps/* paths get a separate header set: the launcher wrapper at
	# /apps/<slug>/ AND (in same-origin mode) the iframe target at
	# /apps/<slug>/<entry> both need ``frame-ancestors 'self'`` (so the
	# launcher can embed the entry) and no XFO at all (Safari treats XFO
	# DENY as authoritative even when CSP frame-ancestors would allow
	# framing, producing a "refused to connect" iframe error). The CSP
	# header itself is stamped by the portal's ChildAppCSPMiddleware,
	# which derives per-app ``connect-src`` from ``App.allowed_origins``
	# — it can't live here because Caddy doesn't see the database. The
	# other defense-in-depth headers stay in Caddy.
	@apps path /apps/*
	header @apps {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# Per-app subdomains. Each child app gets its own browser origin so the
# same-origin policy enforces isolation between apps and between an app and the
# portal shell. ``tls { on_demand }`` makes Caddy fetch a Let's Encrypt
# certificate on the first hit for a previously-unseen subdomain (HTTP-01
# challenge; no DNS-provider credentials required). The global
# ``on_demand_tls.ask`` hook above ensures we only request certs for hostnames
# the portal recognizes as real apps.
*.apps.{$SITE_URL} {
	reverse_proxy portal:8000

	encode zstd gzip

	tls {
		on_demand
	}

	header {
		# Per-app Content-Security-Policy is set by the portal itself, NOT
		# here. The portal's ChildAppCSPMiddleware writes a CSP whose
		# ``connect-src`` directive enumerates the external HTTPS origins
		# the app's manifest declared and an admin approved — that
		# information is per-app and lives in the database, so Caddy can't
		# compute it statically. The middleware always includes
		# ``frame-ancestors https://{$SITE_URL}`` so the iframe-only
		# embedding rule is preserved. The rest of the security headers
		# below are response-agnostic and stay in Caddy.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Defense-in-depth headers mirrored from the portal-shell block.
		# Deliberately NOT mirrored:
		#   - X-Frame-Options DENY: child apps MUST be frameable from the portal
		#     origin (the iframe wrapper). frame-ancestors in the CSP above already
		#     restricts who can frame us; XFO DENY would conflict.
		#   - Cross-Origin-Opener-Policy same-origin: child apps inside an iframe
		#     inherit COOP from the embedder; forcing same-origin here could break
		#     popups apps spawn for downloads / OAuth flows.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
