# Global options. ``on_demand_tls.ask`` tells Caddy to consult the portal
# before issuing a certificate for any host matched by an ``on_demand`` block
# below. Without this guardrail, an attacker could send requests for
# ``<random>.apps.<SITE_URL>`` and burn through Let's Encrypt's per-week
# certificate quota. The portal answers 200 only for real, enabled app slugs
# (and for the portal hostname itself, defensively).
{
	on_demand_tls {
		ask http://portal:8000/api/v1/internal/cert-ask
	}
}

# ─── Shared edge hardening, imported into every site block below ───
#
# Two named matchers plus ``respond 404``. Probes for paths this stack can
# never legitimately serve die here instead of costing a uvicorn worker —
# and, more to the point, an unauthenticated prober learns nothing from the
# response about which app slugs exist.
#
# Where the ``import`` sits inside a site block doesn't matter: ``respond``
# sorts ahead of ``reverse_proxy`` in Caddy's directive order, so these
# always run first. ``header`` sorts ahead of both, so the 404s still carry
# the security headers set further down.
#
# @scanner_ext / @scanner_prefix — PHP, WordPress and CGI probes. The split
# is not cosmetic. Caddy's ``path`` matcher only treats a TRAILING ``*`` as
# a cross-segment prefix match; anything else falls through to Go's
# ``path.Match``, where ``*`` stops at ``/``. So ``path /wp-*`` does catch
# ``/wp-admin/setup-config.php``, but ``path /*.php`` does NOT catch
# ``/vendor/phpunit/…/eval-stdin.php`` — the single most-probed URL on the
# internet. Extension matching therefore has to be ``path_regexp``. Verified
# against a live Caddy; please don't "simplify" it back to a path matcher.
#
# Deliberately NO bare ``/vendor/*``: an uploaded child-app bundle can
# legitimately ship a ``vendor/`` directory of third-party JS, and every
# Composer probe worth blocking ends in ``.php`` anyway.
#
# @dotpaths — any URI with a dot-prefixed segment at any depth: /.git/,
# /.env, /.aws/credentials, /.ssh/id_rsa, /apps/<slug>/.git/config. Same
# reason for the regexp: a path matcher can't express "at any depth".
# Matching runs on the decoded path, so ``/%2egit/config`` is caught too.
#
# The .well-known exclusion is LOAD-BEARING — do not simplify it away:
#   - ``/.well-known/acme-challenge/*`` is the HTTP-01 renewal path. Caddy
#     answers it above the site routes today, but the exclusion keeps
#     renewals working regardless of that internal ordering; lose it and
#     the certificate silently stops renewing and expires ~60 days later.
#   - ``/.well-known/oauth-authorization-server`` and
#     ``/.well-known/oauth-protected-resource/*`` are served by the portal
#     itself (portal/oauth.py ``build_oauth_routes``). 404 them and
#     Claude.ai's remote MCP connector can't discover the endpoints.
#
# fail2ban is unaffected. Each site block's ``log`` directive still records
# every request answered here, and
# contrib/fail2ban/filter.d/pwa-portal-caddy.conf matches on ``client_ip`` +
# ``uri`` without looking at the status, so a bait-path sweep still earns a
# host-firewall ban after three hits — it just no longer touches Python.
(scanner_404) {
	@scanner_ext path_regexp (?i)\.(php|phtml|asp|aspx|jsp|cgi)$
	respond @scanner_ext 404

	@scanner_prefix path /wp-* /cgi-bin/* /phpinfo* /phpmyadmin* /_profiler*
	respond @scanner_prefix 404

	@dotpaths {
		path_regexp dotseg /\.
		not path_regexp wellknown /\.well-known/
	}
	respond @dotpaths 404
}

{$SITE_URL:localhost} {
	import scanner_404

	# lb_try_duration keeps a container restart from becoming a wall of
	# 502s. The portal runs ``alembic upgrade head`` inside its lifespan
	# startup (portal/db.py ``init_db``), so after ``docker compose up -d``
	# the container is up for a beat before uvicorn accepts connections.
	# Caddy retries the dial for up to 15s rather than giving up after the
	# default handful of attempts. Only GETs are retried by default — a
	# replayed POST could double-submit — which covers the case that
	# matters during a restart: page loads.
	reverse_proxy {$PORTAL_UPSTREAM:portal:8000} {
		lb_try_duration 15s
		lb_try_interval 500ms
	}

	encode zstd gzip

	# JSON access log on stdout. Each handled request emits one line with
	# ``request.client_ip``, ``request.uri``, ``status`` etc., which the
	# Docker journald log driver forwards to the host journal under tag
	# ``pwa-portal-caddy`` (see docker-compose.yml). fail2ban filters in
	# ``contrib/fail2ban/`` consume this stream to ban scanners hitting
	# bait paths like ``/.env`` or ``/.git/`` before the request even
	# reaches the portal.
	log {
		output stdout
		format json
	}

	# Portal-shell headers — scoped to NON-/apps/* paths only. The
	# ``not path /apps/*`` matcher is critical: without it, the matcher-less
	# header block gets compiled to run AFTER the @apps matcher block,
	# clobbering the apps-specific CSP and putting an XFO DENY on the iframe
	# target. Scoping both header blocks with matchers means they never
	# overlap on a given request.
	@portal_shell not path /apps/*
	header @portal_shell {
		# HSTS is only emitted over HTTPS by Caddy automatically.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Portal-shell CSP. Stricter than the child-app CSP below: no
		# 'unsafe-eval', no blob:, no data: in default-src. 'unsafe-inline'
		# is required because base.html ships an inline <script> for
		# service-worker registration and templates use inline <style>.
		# frame-ancestors 'none' blocks any page from iframing the shell.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# /apps/* paths get a separate header set: the launcher wrapper at
	# /apps/<slug>/ AND (in same-origin mode) the iframe target at
	# /apps/<slug>/<entry> both need ``frame-ancestors 'self'`` (so the
	# launcher can embed the entry) and no XFO at all (Safari treats XFO
	# DENY as authoritative even when CSP frame-ancestors would allow
	# framing, producing a "refused to connect" iframe error). The CSP
	# header itself is stamped by the portal's ChildAppCSPMiddleware,
	# which derives per-app ``connect-src`` from ``App.allowed_origins``
	# — it can't live here because Caddy doesn't see the database. The
	# other defense-in-depth headers stay in Caddy.
	@apps path /apps/*
	header @apps {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# Per-app subdomains. Each child app gets its own browser origin so the
# same-origin policy enforces isolation between apps and between an app and the
# portal shell. ``tls { on_demand }`` makes Caddy fetch a Let's Encrypt
# certificate on the first hit for a previously-unseen subdomain (HTTP-01
# challenge; no DNS-provider credentials required). The global
# ``on_demand_tls.ask`` hook above ensures we only request certs for hostnames
# the portal recognizes as real apps.
*.apps.{$SITE_URL} {
	# Same hardening as the portal shell, and it matters MORE here: every
	# on-demand certificate this block issues lands in the public
	# Certificate Transparency logs, so ``<slug>.apps.<SITE_URL>`` is
	# enumerable by anyone scraping CT — which is how a scanner ends up
	# probing a real app subdomain in the first place. Without this, a
	# cookie-less GET for /.git/ reaches the portal catch-all and comes back
	# as a 303 to the portal-origin launcher, confirming the slug is live.
	# Now it's a flat 404 before Python ever sees it.
	import scanner_404

	reverse_proxy {$PORTAL_UPSTREAM:portal:8000} {
		lb_try_duration 15s
		lb_try_interval 500ms
	}

	encode zstd gzip

	# Per-app subdomain access log — same format as the portal-shell
	# block above. Scanners probing for child-app paths show up here too.
	log {
		output stdout
		format json
	}

	tls {
		on_demand
	}

	header {
		# Per-app Content-Security-Policy is set by the portal itself, NOT
		# here. The portal's ChildAppCSPMiddleware writes a CSP whose
		# ``connect-src`` directive enumerates the external HTTPS origins
		# the app's manifest declared and an admin approved — that
		# information is per-app and lives in the database, so Caddy can't
		# compute it statically. The middleware always includes
		# ``frame-ancestors https://{$SITE_URL}`` so the iframe-only
		# embedding rule is preserved. The rest of the security headers
		# below are response-agnostic and stay in Caddy.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Defense-in-depth headers mirrored from the portal-shell block.
		# Deliberately NOT mirrored:
		#   - X-Frame-Options DENY: child apps MUST be frameable from the portal
		#     origin (the iframe wrapper). frame-ancestors in the CSP above already
		#     restricts who can frame us; XFO DENY would conflict.
		#   - Cross-Origin-Opener-Policy same-origin: child apps inside an iframe
		#     inherit COOP from the embedder; forcing same-origin here could break
		#     popups apps spawn for downloads / OAuth flows.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
