# The hostname/URL where the portal is reachable.
# Examples:
#   example.com               -> your own domain; Caddy gets a free Let's Encrypt cert
#   portal.example.com        -> a CNAME you set up
#   123.45.67.89.sslip.io     -> no domain; uses your VPS public IP via sslip.io
#   localhost                 -> local dev (HTTP only)
SITE_URL=localhost

# Used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-before-running-in-production

# Set to true when serving over HTTPS in production (cookies are then Secure-only).
# Set to false ONLY for local HTTP development on localhost.
COOKIES_SECURE=true

# Default (unset / false): each child app runs on its own subdomain
# (<slug>.apps.<SITE_URL>) for browser-origin isolation — a malicious
# uploaded app can't read the portal session or other apps' data because
# the same-origin policy blocks it. Requires a wildcard DNS A record
# (*.apps.<SITE_URL>) pointing at this VPS; Caddy fetches Let's Encrypt
# certs on demand per subdomain via HTTP-01 (no DNS provider creds needed).
#
# Set to true to fall back to serving apps same-origin at
# <SITE_URL>/apps/<slug>/. Convenient (no wildcard DNS) but means a
# malicious uploaded app can read the portal's session. The admin
# dashboard shows a warning banner in this mode.
#
# Local dev tip: use SITE_URL=lvh.me (resolves *.lvh.me → 127.0.0.1) to
# test the default model without /etc/hosts edits. Or set this to true
# and stick with SITE_URL=localhost.
CHILD_APPS_SAME_ORIGIN=

# SMTP — used by child apps via the portal's email API.
# Leave SMTP_HOST blank to disable; the email endpoint returns 503 until set.
# An admin settings UI will be able to override these in step 6.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
