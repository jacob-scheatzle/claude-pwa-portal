# The hostname/URL where the portal is reachable.
# Examples:
#   example.com               -> your own domain; Caddy gets a free Let's Encrypt cert
#   portal.example.com        -> a CNAME you set up
#   123.45.67.89.sslip.io     -> no domain; uses your VPS public IP via sslip.io
#   localhost                 -> local dev (HTTP only)
SITE_URL=localhost

# Used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-before-running-in-production

# Set to true when serving over HTTPS in production (cookies are then Secure-only).
# Set to false ONLY for local HTTP development on localhost.
#
# Note: if HTTP_ONLY=true AND you're behind a load balancer that terminates
# TLS, keep this true — uvicorn honors X-Forwarded-Proto from the LB, so
# cookies are still sent over HTTPS at the browser. If HTTP_ONLY=true and
# there's no LB (purely HTTP end-to-end), set this to false or browsers
# will refuse to send the cookies.
COOKIES_SECURE=true

# Set to true to serve plain HTTP instead of auto-HTTPS. The bundled Caddy
# will then listen on port 80 only — no Let's Encrypt requests, no
# on-demand TLS, no HSTS. Two supported deployment shapes:
#
#   1. Behind a load balancer / reverse proxy that terminates TLS for you.
#      Set HTTP_ONLY=true and keep COOKIES_SECURE=true. Port 443 on the
#      compose file can be commented out (Caddy won't bind it).
#
#   2. Local testing or strictly-internal use where TLS is not desired.
#      Set HTTP_ONLY=true and COOKIES_SECURE=false.
#
# Default (unset / false): Caddy serves HTTPS with auto-renewing Let's
# Encrypt certs (the production-recommended path).
HTTP_ONLY=false

# Default (unset / false): each child app runs on its own subdomain
# (<slug>.apps.<SITE_URL>) for browser-origin isolation — a malicious
# uploaded app can't read the portal session or other apps' data because
# the same-origin policy blocks it. Requires a wildcard DNS A record
# (*.apps.<SITE_URL>) pointing at this VPS; Caddy fetches Let's Encrypt
# certs on demand per subdomain via HTTP-01 (no DNS provider creds needed).
#
# Set to true to fall back to serving apps same-origin at
# <SITE_URL>/apps/<slug>/. Convenient (no wildcard DNS) but means a
# malicious uploaded app can read the portal's session. The admin
# dashboard shows a warning banner in this mode.
#
# Local dev tip: use SITE_URL=lvh.me (resolves *.lvh.me → 127.0.0.1) to
# test the default model without /etc/hosts edits. Or set this to true
# and stick with SITE_URL=localhost.
CHILD_APPS_SAME_ORIGIN=

# The MCP app-management server at /mcp lets Claude connect with a URL + admin
# API token and list / upload / replace / enable apps as tool calls. See
# docs/mcp.md for the connect command.
#
# Leave BLANK for auto: enabled whenever the optional `mcp` package is present —
# and the Docker image bundles it, so /mcp is live out of the box. Set `false`
# to disable; set `true` to require it (logs a warning if the package is
# missing). Non-Docker install: `pip install 'pwa-portal[mcp]'`.
MCP_ENABLED=

# Proxy hops whose X-Forwarded-For header uvicorn trusts when deriving the
# client IP (used for login throttling + the fail2ban security log). Leave
# BLANK to use the image default — the RFC1918 private ranges — which trusts
# Caddy on the Docker bridge but ignores a client-supplied (spoofable) header.
# Only set this if a TLS-terminating load balancer forwards to the portal from a
# PUBLIC IP with no Caddy in front: list that IP/CIDR here. Surfacing real client
# IPs also requires Docker `userland-proxy: false` (see docs/deploying.md).
FORWARDED_ALLOW_IPS=

# SMTP — used by child apps via the portal's email API.
# Leave SMTP_HOST blank to disable; the email endpoint returns 503 until set.
# An admin settings UI will be able to override these in step 6.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
